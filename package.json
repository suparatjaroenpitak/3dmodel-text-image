{
  "name": "hunyuan-desktop-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline desktop workspace for Hunyuan3D",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/runtime.cjs && node --check desktop/generate.cjs && node --check src/main.js && node --check src/viewer.js && node --check src/model-files.js",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.hunyuanstudio.desktop",
    "productName": "Hunyuan Studio",
    "directories": {
      "output": "outputs/installer"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Hunyuan-Studio-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hunyuan Studio"
    }
  }
}
